{
  "components": {
    "schemas": {
      "ConnectorStatus": {
        "properties": {
          "can_publish": {
            "title": "Can Publish",
            "type": "boolean"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ServiceState"
          }
        },
        "required": [
          "name",
          "state",
          "can_publish",
          "mode"
        ],
        "title": "ConnectorStatus",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ServiceState"
          }
        },
        "required": [
          "name",
          "state",
          "latency_ms"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LiveResponse",
        "type": "object"
      },
      "ServiceState": {
        "enum": [
          "ready",
          "unavailable"
        ],
        "title": "ServiceState",
        "type": "string"
      },
      "SystemState": {
        "enum": [
          "ready",
          "degraded"
        ],
        "title": "SystemState",
        "type": "string"
      },
      "SystemStatus": {
        "properties": {
          "application": {
            "title": "Application",
            "type": "string"
          },
          "connectors": {
            "items": {
              "$ref": "#/components/schemas/ConnectorStatus"
            },
            "title": "Connectors",
            "type": "array"
          },
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SystemState"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "application",
          "version",
          "environment",
          "state",
          "dependencies",
          "connectors"
        ],
        "title": "SystemStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Shared API for chat-first SMM operations.",
    "title": "SMM GPT API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/system/status": {
      "get": {
        "description": "Return dependency and connector state without exposing secrets.",
        "operationId": "system_status_api_v1_system_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "System Status",
        "tags": [
          "system"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Confirm that the ASGI process can serve requests.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report ready only when PostgreSQL and Redis respond.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
