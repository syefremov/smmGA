{
  "components": {
    "schemas": {
      "APIError": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "APIError",
        "type": "object"
      },
      "ConnectorStatus": {
        "properties": {
          "can_publish": {
            "title": "Can Publish",
            "type": "boolean"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ServiceState"
          }
        },
        "required": [
          "name",
          "state",
          "can_publish",
          "mode"
        ],
        "title": "ConnectorStatus",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ServiceState"
          }
        },
        "required": [
          "name",
          "state",
          "latency_ms"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "DiagnosticRequest": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "idempotency_key"
        ],
        "title": "DiagnosticRequest",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LiveResponse",
        "type": "object"
      },
      "ServiceState": {
        "enum": [
          "ready",
          "unavailable"
        ],
        "title": "ServiceState",
        "type": "string"
      },
      "SystemState": {
        "enum": [
          "ready",
          "degraded"
        ],
        "title": "SystemState",
        "type": "string"
      },
      "SystemStatus": {
        "properties": {
          "application": {
            "title": "Application",
            "type": "string"
          },
          "connectors": {
            "items": {
              "$ref": "#/components/schemas/ConnectorStatus"
            },
            "title": "Connectors",
            "type": "array"
          },
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SystemState"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "application",
          "version",
          "environment",
          "state",
          "dependencies",
          "connectors"
        ],
        "title": "SystemStatus",
        "type": "object"
      }
    }
  },
