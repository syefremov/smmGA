# Server-only settings. This file is a template, not an enabled Compose overlay.
SMM_AUTH_ENABLED=true
SMM_WEB_ORIGIN=https://<private-smm-host>
SMM_OIDC_ISSUER_URL=https://<private-idp-host>/application/o/smm-web/
SMM_OIDC_CLIENT_ID=smm-web
SMM_OIDC_CLIENT_SECRET=<from-server-secret-store>
SMM_MCP_ISSUER_URL=https://<private-idp-host>/application/o/smm-mcp/
SMM_MCP_CLIENT_ID=https://<private-smm-host>/mcp/
SMM_MCP_RESOURCE_URL=https://<private-smm-host>/mcp/
