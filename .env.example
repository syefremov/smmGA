# Application
SMM_ENV=development
SMM_LOG_LEVEL=INFO
SMM_TIMEZONE=Europe/Moscow
SMM_API_BIND=0.0.0.0
SMM_API_PORT=8000
SMM_WEB_ORIGIN=http://127.0.0.1:8080

# Local infrastructure. Run `pnpm env:init`; do not copy these placeholders to a server.
SMM_POSTGRES_DB=smm_gpt
SMM_POSTGRES_USER=smm_gpt
SMM_POSTGRES_PASSWORD=<generated-locally>
SMM_APP_PASSWORD=<generated-locally>
SMM_WORKER_PASSWORD=<generated-locally>
SMM_POSTGRES_PORT=5432
SMM_REDIS_PORT=6379
SMM_DATABASE_URL=<generated-locally>
SMM_REDIS_URL=redis://127.0.0.1:6379/0
SMM_MEDIA_ROOT=.data/media

# Browser and MCP authentication
SMM_AUTH_ENABLED=false
SMM_OIDC_ISSUER_URL=<set-in-local-env>
SMM_OIDC_CLIENT_ID=<set-in-local-env>
SMM_OIDC_CLIENT_SECRET=<set-in-local-env>
SMM_MCP_RESOURCE_URL=http://127.0.0.1:8080/mcp/
SMM_MCP_ISSUER_URL=<exact-issuer-of-predefined-mcp-provider>
SMM_MCP_CLIENT_ID=<predefined-personal-oauth-client>

# External providers remain disabled until explicitly configured.
SMM_AI_PROVIDER=disabled
SMM_AI_API_KEY=<set-in-server-env-only>
SMM_VK_ENABLED=false
SMM_VK_ACCESS_TOKEN=<set-in-server-env-only>
