{
    auto_https off
    admin off
}

:8080 {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    handle /api/* {
        reverse_proxy app:8000
    }

    handle /health/* {
        reverse_proxy app:8000
    }

    handle /mcp* {
        reverse_proxy app:8000 {
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
