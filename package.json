{
  "name": "smm-gpt",
  "version": "0.1.0",
  "private": true,
  "description": "Chat-first SMM operations platform",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "bootstrap": "pwsh -NoLogo -NoProfile -File ./scripts/bootstrap-dev.ps1",
    "doctor": "pwsh -NoLogo -NoProfile -File ./scripts/doctor.ps1",
    "check": "pwsh -NoLogo -NoProfile -File ./scripts/check-fast.ps1",
    "dev": "pwsh -NoLogo -NoProfile -File ./scripts/project-command.ps1 -CommandName dev",
    "test": "pwsh -NoLogo -NoProfile -File ./scripts/project-command.ps1 -CommandName test",
    "build": "pwsh -NoLogo -NoProfile -File ./scripts/project-command.ps1 -CommandName build",
    "db:migrate": "pwsh -NoLogo -NoProfile -File ./scripts/project-command.ps1 -CommandName db:migrate"
  }
}
